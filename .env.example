# ============================================================
# Mara OS — Configuración (copia a .env y rellena los valores)
#   cp .env.example .env
# ============================================================

# === Telegram ===
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Nombre con el que se etiqueta al usuario en los mensajes espejados a Telegram
# desde el micrófono del navegador/UI (por defecto "Kike").
# Ojo: TELEGRAM_CHAT_ID es necesario para que el espejado transcripción+respuesta llegue a Telegram.
# MARA_USER_NAME=Kike
# Mensaje de bienvenida largo al arrancar (estado + comandos). "false" lo silencia;
# /start y /help lo siguen mostrando bajo demanda.
# STARTUP_WELCOME=true
# Nivel de log: debug | info | warn | error (por defecto info).
# LOG_LEVEL=info

# === Servidor de inferencia ===
# Mara OS no ejecuta el LLM: habla con un servidor local o con la nube.
# Proveedores disponibles:
#   unsloth → Unsloth Studio en la LAN (API OpenAI-compatible)   [OLLAMA_*]
#   groq    → Groq Cloud (API OpenAI-compatible)                  [GROQ_*]
#   ollama  → Ollama nativo en la LAN                             [OLLAMA_*]
#   openai  → otro servidor OpenAI-compatible                     [LLM_*]
#
# El proveedor activo se cambia EN CALIENTE desde Telegram, sin reiniciar:
#   /modelo            → estado de todos y cuál está activo
#   /modelo groq       → comprueba que responde y lo activa
# El elegido se guarda en data/llm-provider.json y manda sobre LLM_PROVIDER.
#
# LLM_PROVIDER es solo el VALOR INICIAL (primer arranque, o si no hay nada
# guardado todavía). Si sólo vas a usar uno, ponlo aquí.
LLM_PROVIDER=unsloth

# --- Servidor local: Unsloth Studio u Ollama ---
# Dialecto de la API:
#   "ollama" → /api/chat, /api/generate  (Ollama nativo)
#   "openai" → /v1/chat/completions      (Unsloth Studio, vLLM, llama.cpp
#                                         server, LM Studio…)
OLLAMA_API=openai
OLLAMA_URL=http://192.168.1.79:8888
OLLAMA_MODEL=unsloth/Qwen3.5-4B-MTP-GGUF
# API key del servidor → Authorization: Bearer <key>.
# Vacío = sin cabecera (un Ollama normal no pide auth). No la commitees.
OLLAMA_API_KEY=
# Solo dialecto "ollama": tamaño de ventana de contexto por petición. OBLIGATORIO
# subirlo del default: Ollama usa 4096 si el Modelfile no define num_ctx, y las
# tools MCP (~3k tokens) desbordan el prompt con cualquier mensaje →
# HTTP 400 exceed_context_size_error. En dialecto openai no aplica: el contexto
# lo fija el modelo cargado en el servidor.
OLLAMA_NUM_CTX=16384

# --- Groq Cloud ---
# La base incluye /openai: las rutas son https://api.groq.com/openai/v1/...
GROQ_API_URL=https://api.groq.com/openai
# 131k de contexto y 16k de salida. Muy buen tool calling.
GROQ_MODEL=qwen/qwen3.8-27b
# Sin key, `/modelo groq` rechaza el cambio con un aviso claro.
GROQ_API_KEY=

# --- Estado y overrides ---
# Dónde se guarda el proveedor elegido con /modelo (por defecto
# data/llm-provider.json). En Docker, dentro del volumen /app/data.
# LLM_STATE_FILE=./data/llm-provider.json
# Overrides genéricos (cualquier proveedor): si están definidos ganan sobre los
# del proveedor. Útiles para un proxy o para probar otro modelo sin tocar el resto.
# LLM_API_URL=
# LLM_MODEL=
# LLM_API_KEY=
# Tope de tokens por respuesta (default: 4096 en groq, 2048 en el resto).
# LLM_MAX_TOKENS=
TIMEZONE=Europe/Madrid

# === STT (transcripción de voz) ===
# Interruptor maestro. false = el bot NO transcribe nada: no descarga el audio,
# no carga whisper y no llama a Voicebox; contesta al instante con un aviso.
STT_ENABLED=false
# Solo si STT_ENABLED=true. true = whisper en esta máquina; false = Voicebox.
# En Raspberry Pi lo único razonable es false (whisper local no da CPU).
STT_LOCAL_ENABLED=true
# Modelo whisper: "Xenova/whisper-tiny" (rápido), "Xenova/whisper-base",
# "Xenova/whisper-small" (preciso) o "onnx-community/whisper-large-v3-turbo".
# OJO: el turbo exige onnxruntime >= 1.20 (IR version 10); con el
# @xenova/transformers 2.x fijado aquí falla con "Unsupported model IR version: 10".
STT_MODEL=Xenova/whisper-tiny
# ISO del idioma (ej. "es", "en"); "auto" para autodetección
STT_LANGUAGE=es
# Dónde se guardan los pesos. NUNCA dentro de node_modules: un pnpm install los
# borra y obliga a volver a bajar cientos de MB.
STT_CACHE_DIR=./data/models
# Tiempo máximo de una transcripción local en ms (evita que un STT atascado
# bloquee la cola de mensajes del chat). Por defecto 60000.
# STT_TIMEOUT_MS=60000

# === Voz (Voicebox TTS) ===
VOICEBOX_ENABLED=false
VOICEBOX_URL=http://192.168.1.79:17493
VOICEBOX_PROFILE=Mara
VOICEBOX_TRANSCRIBE_MODEL=whisper-turbo
TELEGRAM_SEND_VOICE=false

# === Hindsight (memoria a largo plazo) ===
# Hindsight es el backend principal de memoria a largo plazo. El servidor vive
# en la LAN (CHUWI HeroBox) y este proceso NO ejecuta ningún LLM.
# false o ausente = comportamiento anterior: todo en SQLite (data/mara.db).
HINDSIGHT_ENABLED=true
HINDSIGHT_API_URL=http://192.168.1.196:8888
HINDSIGHT_BANK_ID=mara-os
# Si el servidor tiene autenticación activada, pon aquí la API key. Vacío = sin
# cabecera Authorization. Se envía como "Authorization: Bearer <key>".
# HINDSIGHT_API_KEY=
# Tenant de la API (por defecto "default", el de la ruta /v1/default/...).
# HINDSIGHT_TENANT=default
# Timeouts en ms. recall/list/get deben ser rápidos; retain extrae hechos con
# LLM en el servidor y necesita más margen.
# HINDSIGHT_TIMEOUT_MS=8000
# HINDSIGHT_RETAIN_TIMEOUT_MS=25000
# HINDSIGHT_HEALTH_TIMEOUT_MS=2500
# Outbox: cuántos cambios se reintentan por pasada y cada cuánto (0 = sin timer).
# HINDSIGHT_SYNC_BATCH_SIZE=10
# HINDSIGHT_SYNC_INTERVAL_MS=60000
# Ojo: esto es del SERVIDOR Hindsight, no de Mara. Si Hindsight usa Groq en plan
# gratuito, configúralo con HINDSIGHT_API_LLM_PROVIDER=openai y
# HINDSIGHT_API_LLM_BASE_URL=https://api.groq.com/openai/v1; con el proveedor
# "groq" cada retain falla con HTTP 500 ("service_tier auto is not available")
# y /help muestra Hindsight ❌. Ver docs/operations/memory-management.md.

# === Extracción de memoria ===
# Importancia mínima (0-1) para guardar un hecho extraído de la conversación.
# Sube el umbral si ves recuerdos de charla trivial.
# MEMORY_MIN_IMPORTANCE=0.5
# Mínimo de ms entre extracciones del mismo chat (0 = sin límite).
# MEMORY_EXTRACTION_MIN_INTERVAL_MS=60000

# === MCP ===
# mcp.json admite ${VAR} y ${VAR:-por_defecto}, así que URLs y secretos no
# quedan escritos en el repo.
# AgentDesk (único servidor MCP). El token es secreto: solo aquí, nunca en
# mcp.json. Sin token, AgentDesk rechaza la conexión (401).
AGENTDESK_MCP_URL=http://192.168.1.196:3000/api/mcp
AGENTDESK_MCP_TOKEN=
# Desactiva servidores por nombre, separados por comas, sin tocar mcp.json.
# MCP_DISABLED_SERVERS=
# Servidores MCP que cuentan como backend de memoria. Vacío por defecto: con
# Hindsight activo la memoria la gestiona el bot (REST), no un MCP. Si declaras
# uno aquí, se conecta como herramienta manual pero no sustituye a Hindsight.
# MCP_MEMORY_SERVERS=
# Grupos de tools activables con /tools. La definición (grupo → tools) está en
# config/tool-groups.json; los grupos apagados se guardan en el fichero de estado
# (en Docker, dentro del volumen /app/data). La memoria siempre está activa.
# TOOL_GROUPS_FILE=./config/tool-groups.json
# TOOL_GROUPS_STATE_FILE=./data/tool-groups.json

# === Mara UI (bridge WebSocket) ===
# UI se conecta al bridge local (este valor va en el .env de mara-ui)
# VITE_MARA_WS_URL=ws://localhost:8765
# El bridge se conecta al brain de MaraOS (este valor va aquí)
# MARA_BRAIN_WS_URL=ws://192.168.1.50:9000
