TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
TIMEZONE=Europe/Madrid
VOICEBOX_URL=http://192.168.1.79:17493
VOICEBOX_ENABLED=true
VOICEBOX_PROFILE=Mara
VOICEBOX_TRANSCRIBE_MODEL=whisper-turbo
TELEGRAM_SEND_VOICE=true
# STT local (whisper.cpp en Apple Silicon). true por defecto; pon false para usar Voicebox como STT.
STT_LOCAL_ENABLED=true
# Modelo whisper.cpp: "large-v3-turbo" (mejor precisión, rápido en Apple Silicon) o "small" (ligero).
STT_MODEL=large-v3-turbo
# Idioma del audio entrante (ISO, ej. "es"). "auto" para autodetección.
STT_LANGUAGE=es
