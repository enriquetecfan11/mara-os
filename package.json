{
  "name": "agente-bolsillo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bot": "node --env-file-if-exists=.env --import tsx src/bot.ts",
    "bot:lite": "node --env-file-if-exists=.env --import tsx src/bot-lite.ts",
    "check:ollama": "node --env-file-if-exists=.env --import tsx scripts/check-ollama.ts",
    "typecheck": "tsc --noEmit",
    "reset-bot": "rm -rf config/MEMORY.md && touch config/MEMORY.md",
    "reset-memory": "git checkout config/MEMORY.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "grammy": "^1.38.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
